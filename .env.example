# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
MCP_PATH=/mcp

# Comma-separated allowlists used by the MCP HTTP adapter.
# In production, include the public hostname, e.g. social.example.com.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=

# Protect the remote MCP endpoint. Generate a long random value.
MCP_AUTH_TOKEN=

# Protect /connect and provider authorization start routes with HTTP Basic auth.
# Username is always: owner
OWNER_ACCESS_PASSWORD=

# Database
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tho_social_publisher

# Generate exactly 32 random bytes, encoded as 64-char hex or base64.
# Never commit the real key.
TOKEN_ENCRYPTION_KEY=

# Threads OAuth
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/oauth/threads/callback

# Publishing safety
# Exact/normalized duplicates on the same provider are blocked if they occur
# within this many hours of each other. Set 0 to disable. Max: 168.
DUPLICATE_GUARD_HOURS=24

# Scheduling
JOB_CONCURRENCY=2

# Optional providers — enable only after their adapters are implemented.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/oauth/tiktok/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/oauth/x/callback

# Logging
LOG_LEVEL=info
