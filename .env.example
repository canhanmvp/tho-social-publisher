# Application
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
MCP_PATH=/mcp

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tho_social_publisher

# Generate a strong random value for production.
# Never commit the real key.
TOKEN_ENCRYPTION_KEY=

# Threads / Meta
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/oauth/threads/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/oauth/meta/callback

# Optional providers — enable only after their adapters are implemented.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/oauth/tiktok/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/oauth/x/callback

# Scheduling
JOB_CONCURRENCY=5

# Logging
LOG_LEVEL=info
